{
	"name": "budget-tracker-pwa",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"build:capacitor": "vite build --mode capacitor",
		"build:android": "bun run build:capacitor && cap sync android",
		"android:open": "cap open android",
		"preview": "vite preview",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"devDependencies": {
		"@capacitor/cli": "^8.5.3",
		"@sveltejs/adapter-auto": "8.0.0",
		"@sveltejs/adapter-static": "^4.0.0",
		"@sveltejs/kit": "3.0.0",
		"@sveltejs/vite-plugin-svelte": "7.2.0",
		"@tailwindcss/vite": "^4.1.0",
		"@typescript-eslint/parser": "^8.72.0",
		"daisyui": "^5.7.50",
		"eslint": "^10.13.0",
		"eslint-plugin-simple-import-sort": "^14.0.0",
		"svelte": "5.57.1",
		"svelte-check": "4.6.0",
		"svelte-eslint-parser": "^1.9.0",
		"tailwindcss": "^4.1.0",
		"typescript": "6.0.3",
		"vite": "8.3.0"
	},
	"dependencies": {
		"@capacitor/android": "^8.5.3",
		"@capacitor/core": "^8.5.3",
		"@capacitor/preferences": "^8.0.1",
		"bcrypt-ts": "^9.0.2",
		"felte": "^1.3.0",
		"flag-icons": "^7.6.0",
		"jose": "^6.2.13",
		"libphonenumber-js": "^1.12.0",
		"mongoose": "9.11.3",
		"yup": "^1.7.1"
	}
}